# opencode-proxy - configuration
# Copy for local dev: `cp .env.example .env`
# Reference for `docker run -e` flags and hosting platform env vars.

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# Mode A (default, pass-through): leave OPENCODE_API_KEY empty.
#   Warp sends `Authorization: Bearer <key>`; proxy forwards it unchanged.
# Mode B (override): set OPENCODE_API_KEY to replace the client header.
OPENCODE_API_KEY=

# Empty = random UUID per boot (prompt cache resets on restart).
# Set a stable id to keep prompt caching across restarts.
SESSION_ID=

# Must identify as a coding agent; generic SDK user-agents are blocked upstream.
USER_AGENT=chof64/opencode-proxy/1.0

# Listen address. Dockerfile forces 0.0.0.0; code falls back to 127.0.0.1 if unset.
HOST=0.0.0.0

# Listen port.
PORT=8080

# Max request body size in bytes (10 MB). Larger payloads get 413.
MAX_BODY_BYTES=10485760

# Per-request timeout in ms for client + upstream.
REQUEST_TIMEOUT_MS=60000

# Upstream base URL. Override only for tests/stubs.
UPSTREAM_BASE=https://opencode.ai/zen/go
